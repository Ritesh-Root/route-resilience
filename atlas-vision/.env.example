# Route Resilience — frontend environment variables.
# Copy this file to `.env` (or `.env.local`) and adjust as needed.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets in VITE_ variables — they ship to the client.

# Base URL of the Route Resilience FastAPI backend.
# All API routes are served under `${VITE_API_BASE}/api`
# (e.g. ${VITE_API_BASE}/api/health, ${VITE_API_BASE}/api/network).
# Consumed by src/lib/config.ts (exported as API_BASE).
VITE_API_BASE=http://localhost:8000
